# Copy thanh .env roi dien gia tri that. Truyen vao container qua --env-file .env
# LUU Y: cac service chay TRONG container -> "localhost" la chinh container.
# De tro toi DB/Redis/Mongo chay tren may host, dung host.docker.internal.

# --- MariaDB (JPA) ---
SPRING_DATASOURCE_URL=jdbc:mariadb://host.docker.internal:3306/wisdom_social
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

# --- MongoDB ---
SPRING_DATA_MONGODB_URI=mongodb://host.docker.internal:27017/wisdom_social

# --- Redis ---
SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- AWS S3 / CDN ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET_NAME=
APP_CDN_DOMAIN=

# --- JWT / Cognito ---
JWT_SECRET_KEY=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# --- AI provider (ai-service) ---
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# --- Web ---
APP_WEB_URL=http://localhost:5173

# (Tuy chon) chinh RAM moi JVM; mac dinh -Xmx512m/service
# JAVA_OPTS=-Xms128m -Xmx384m
